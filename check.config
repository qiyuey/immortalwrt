# 个人固件功能清单（从当前 .config 整理，中文注释）
# 保留功能入口、独立能力及必要的默认值覆盖；自动依赖交给 defconfig。
# 默认已关闭的项目不列出；禁用项只用于保留与默认值不同的选择。
# 使用：cp check.config .config && make defconfig
# 源码、feeds 或配置变化后需重新验证。

# 目标平台、镜像与分区参数
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# 构建方式与源码压缩
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_LUCI_SRCDIET=y

# 覆盖上游默认值的禁用项（省略会改变当前配置）
# CONFIG_GRUB_IMAGES is not set
# CONFIG_KERNEL_CGROUPS is not set
# CONFIG_PACKAGE_bnx2-firmware is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_kmod-8139cp is not set
# CONFIG_PACKAGE_kmod-8139too is not set
# CONFIG_PACKAGE_kmod-amazon-ena is not set
# CONFIG_PACKAGE_kmod-amd-xgbe is not set
# CONFIG_PACKAGE_kmod-bnx2 is not set
# CONFIG_PACKAGE_kmod-button-hotplug is not set
# CONFIG_PACKAGE_kmod-dwmac-intel is not set
# CONFIG_PACKAGE_kmod-e1000 is not set
# CONFIG_PACKAGE_kmod-e1000e is not set
# CONFIG_PACKAGE_kmod-forcedeth is not set
# CONFIG_PACKAGE_kmod-hwmon-core is not set
# CONFIG_PACKAGE_kmod-i40e is not set
# CONFIG_PACKAGE_kmod-igb is not set
# CONFIG_PACKAGE_kmod-igbvf is not set
# CONFIG_PACKAGE_kmod-ixgbe is not set
# CONFIG_PACKAGE_kmod-ixgbevf is not set
# CONFIG_PACKAGE_kmod-libphy is not set
# CONFIG_PACKAGE_kmod-mii is not set
# CONFIG_PACKAGE_kmod-net-selftests is not set
# CONFIG_PACKAGE_kmod-pcnet32 is not set
# CONFIG_PACKAGE_kmod-pcs-xpcs is not set
# CONFIG_PACKAGE_kmod-phy-ax88796b is not set
# CONFIG_PACKAGE_kmod-phylink is not set
# CONFIG_PACKAGE_kmod-r8101 is not set
# CONFIG_PACKAGE_kmod-r8125 is not set
# CONFIG_PACKAGE_kmod-r8126 is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-stmmac-core is not set
# CONFIG_PACKAGE_kmod-tg3 is not set
# CONFIG_PACKAGE_kmod-tulip is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-net-asix is not set
# CONFIG_PACKAGE_kmod-usb-net-asix-ax88179 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8150 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor is not set
# CONFIG_PACKAGE_kmod-vmxnet3 is not set
# CONFIG_PACKAGE_knot-resolver_dnstap is not set
# CONFIG_PACKAGE_libfdisk is not set
# CONFIG_TARGET_IMAGES_GZIP is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_PACKAGE_btrfs-progs is not set
# CONFIG_PACKAGE_kmod-crypto-blake2b is not set
# CONFIG_PACKAGE_kmod-crypto-xxhash is not set
# CONFIG_PACKAGE_kmod-fs-btrfs is not set
# CONFIG_PACKAGE_kmod-lib-zstd is not set
# CONFIG_PACKAGE_libattr is not set
# CONFIG_PACKAGE_liblzo is not set
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs is not set

# 网络排障、下载与证书工具
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_openssl-util=y

# 地区与语言默认设置
CONFIG_PACKAGE_default-settings-chn=y

# 其他独立工具和功能选项
CONFIG_PACKAGE_htop=y

# 硬件支持与其他内核模块
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# 网络应用与协议界面（基础页面和翻译由依赖生成）
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# 磁盘管理与文件系统工具
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y

# Web 管理、主题与后端接口
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-argon=y

# Nginx HTTPS 服务与模块选项
CONFIG_PACKAGE_nginx-ssl=y
